#pragma kernel CSMain

// RWTexture2D for writing the output
RWTexture2D<float4> Result;

// Texture dimensions
int Width;
int Height;

[numthreads(8,8,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    // Bounds checking
    if (id.x >= Width || id.y >= Height)
        return;

    // Checkerboard logic
    int x = id.x;
    int y = id.y;

    // Check if the sum of x and y is even or odd
    bool isWhite = ((x / 8 + y / 8) % 2) == 0;

    // Assign white or black color based on checkerboard pattern
    float4 color = isWhite ? float4(1.0, 1.0, 1.0, 0.5) : float4(0.0, 0.0, 0.0, 0.5);

    Result[id.xy] = color;
}