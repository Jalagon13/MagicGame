#pragma kernel CSMain

// Tile data (1 = opaque, 0 = transparent)
StructuredBuffer<uint> TileData;

// Light sources (position, intensity, radius)
StructuredBuffer<float4> LightSources; // Each float4 is (x, y, intensity, radius)

// Output lightmap
RWTexture2D<float4> Result;

// World/tilemap dimensions
int Width;
int Height;
int NumLights;

// Function to calculate light contribution for a pixel
float3 CalculateLightContribution(float2 targetPos, float4 lightSource)
{
    float2 lightPos = lightSource.xy;
    float intensity = lightSource.z; // Float between 0 and 1
    float radius = lightSource.w;   // Light radius

    float distance = length(targetPos - lightPos);

    float currentIntensity = intensity;

    int opaqueTilesFound = 0;        // Tracks the number of opaque tiles encountered
    int opaqueTilesTolerance = 2;   // Tolerance for light bleeding

    // Differences in x and y
    float xDiff = targetPos.x - lightPos.x;
    float yDiff = targetPos.y - lightPos.y;

    // Determine dominant axis and step sizes
    float xStep, yStep;
    int iterations;

    if (abs(xDiff) > abs(yDiff))
    {
        xStep = xDiff > 0 ? 1.0 : -1.0;
        yStep = yDiff / abs(xDiff); // Proportional step in y
        iterations = abs(xDiff);   // Number of steps along x
    }
    else
    {
        yStep = yDiff > 0 ? 1.0 : -1.0;
        xStep = xDiff / abs(yDiff); // Proportional step in x
        iterations = abs(yDiff); // Number of steps along y
    }

    // Start traversing from the light source position
    float2 currentPos = lightPos;

    for (int i = 0; i < iterations; ++i)
    {
        // Calculate the current tile position
        int tileX = int(round(currentPos.x));
        int tileY = int(round(currentPos.y));
        int tileIndex = tileY * Width + tileX;

        // Check tile transparency
        uint tileTransparency = TileData[tileIndex];

        if (tileTransparency == 1) // Opaque tile
        {
            if (opaqueTilesFound < opaqueTilesTolerance)
            {
                opaqueTilesFound++;
                currentIntensity *= 0.98; // Minor reduction
            }
            else
            {
                currentIntensity *= 0.65; // Major reduction
            }
        }
        else // Transparent tile
        {
            currentIntensity *= 0.98; // Minor reduction
        }

        // Stop if intensity is too low
        if (currentIntensity < 0.01)
        {
            return float3(0, 0, 0);
        }

        // Move to the next position
        currentPos += float2(xStep, yStep);
    }

    // Apply distance-based attenuation
    float normalizedDistance = distance / radius;
    float attenuation = (1.0 - normalizedDistance) * (1.0 - normalizedDistance); // Quadratic falloff
    attenuation = max(attenuation, 0.0); // Ensure it doesn't go negative
    currentIntensity *= attenuation;

    return float3(currentIntensity, currentIntensity, currentIntensity);
}

[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID) 
{
    // Ensure we're within bounds
    if (id.x >= Width || id.y >= Height) return;

    // Get pixel coordinates
    int x = id.x;
    int y = id.y;

    // Calculate the 1D index of the tile in the buffer
    int tileIndex = y * Width + x;

    // Start with no light
    float4 pixelColor = float4(0.005, 0.005, 0.005, 1);

    // Read tile transparency (1 = opaque, 0 = transparent)
    uint tileTransparency = TileData[tileIndex];
    
    // Process all lights
    for (int i = 0; i < NumLights; ++i)
    {
        float4 lightSource = LightSources[i];

        // Calculate distance from the light source
        float distance = length(float2(x, y) - lightSource.xy);

        // Light falls off based on distance and radius
        if (distance <= lightSource.w) // w = radius
        {
             // Pixel falls within the light radius
            pixelColor.rgb += CalculateLightContribution(float2(x, y), lightSource);

            break; // Just process the one light it finds for now for testing for one light for now
        }
    }

    // Clamp light to [0, 1] range
    pixelColor.rgb = clamp(pixelColor.rgb, 0.0, 1.0);

    // Write the final color
    Result[int2(x, y)] = pixelColor;
}